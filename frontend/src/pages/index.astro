---
import Layout from '../layouts/Layout.astro';
import WaveformVisualizer from '../components/WaveformVisualizer';
---

<Layout title="Home">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-24 pb-20 lg:pt-36 lg:pb-32">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <p class="text-label text-copper mb-6 reveal stagger-1">Audio Intelligence Platform</p>
          <h1 class="heading-display text-5xl sm:text-6xl lg:text-8xl mb-8 reveal stagger-2">
            Your audio<br />
            <span class="italic text-copper">knows more</span><br />
            than you think.
          </h1>
          <p class="text-lg lg:text-xl text-ink-muted leading-relaxed max-w-lg mb-10 reveal stagger-3">
            Upload any audio. Get transcriptions, translations, semantic answers,
            and AI-curated learning resources &mdash; all from a single file.
          </p>
          <div class="flex flex-wrap gap-4 reveal stagger-4">
            <a
              href="/app"
              class="inline-flex items-center gap-2 px-7 py-3.5 bg-ink text-cream font-medium rounded-full hover:bg-ink-light transition-colors"
            >
              Launch App
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
            <a
              href="/features"
              class="inline-flex items-center gap-2 px-7 py-3.5 border-2 border-ink text-ink font-medium rounded-full hover:bg-ink hover:text-cream transition-colors"
            >
              Explore Features
            </a>
          </div>
        </div>

        <!-- Right side: waveform + decorative -->
        <div class="lg:col-span-5 reveal stagger-3">
          <div class="relative">
            <!-- Decorative frame -->
            <div class="bg-paper-warm rounded-2xl p-8 border border-paper-dark">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-3 h-3 rounded-full bg-copper/30"></div>
                <div class="w-3 h-3 rounded-full bg-amber/30"></div>
                <div class="w-3 h-3 rounded-full bg-sage/30"></div>
                <span class="ml-auto text-xs text-slate font-mono">audio_session.wav</span>
              </div>
              <WaveformVisualizer client:visible />
              <div class="mt-6 space-y-3">
                <div class="flex items-center gap-3">
                  <span class="text-label text-slate">Duration</span>
                  <span class="waveform-line flex-1"></span>
                  <span class="text-sm font-mono text-ink-muted">14:32</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-label text-slate">Language</span>
                  <span class="waveform-line flex-1"></span>
                  <span class="text-sm font-mono text-ink-muted">Auto-detect</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-label text-slate">Chunks</span>
                  <span class="waveform-line flex-1"></span>
                  <span class="text-sm font-mono text-ink-muted">48 segments</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ticker / stats bar -->
  <section class="bg-ink text-cream py-6 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-wrap justify-between items-center gap-8 text-center">
        <div>
          <p class="text-2xl lg:text-3xl font-serif">RAG</p>
          <p class="text-xs text-slate mt-1">Retrieval-Augmented Generation</p>
        </div>
        <div class="hidden sm:block w-px h-10 bg-ink-muted"></div>
        <div>
          <p class="text-2xl lg:text-3xl font-serif">Whisper</p>
          <p class="text-xs text-slate mt-1">Audio Transcription</p>
        </div>
        <div class="hidden sm:block w-px h-10 bg-ink-muted"></div>
        <div>
          <p class="text-2xl lg:text-3xl font-serif">pgvector</p>
          <p class="text-xs text-slate mt-1">Vector Similarity Search</p>
        </div>
        <div class="hidden sm:block w-px h-10 bg-ink-muted"></div>
        <div>
          <p class="text-2xl lg:text-3xl font-serif">AI Agent</p>
          <p class="text-xs text-slate mt-1">Learning Recommendations</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features preview -->
  <section class="py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div class="group reveal stagger-1">
          <div class="bg-paper-warm rounded-2xl p-8 border border-paper-dark h-full hover:border-copper/30 transition-colors">
            <div class="flex items-center gap-2 mb-6">
              <span class="text-label text-copper">01</span>
              <div class="waveform-line flex-1"></div>
            </div>
            <h3 class="heading-editorial text-2xl mb-3">Audio Processing</h3>
            <p class="text-ink-muted leading-relaxed mb-6">
              Upload any audio format. Whisper handles transcription, detects the language and translates when needed. Your audio becomes searchable text.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-cream rounded-full text-xs font-medium text-ink-muted">mp3</span>
              <span class="px-3 py-1 bg-cream rounded-full text-xs font-medium text-ink-muted">wav</span>
              <span class="px-3 py-1 bg-cream rounded-full text-xs font-medium text-ink-muted">m4a</span>
              <span class="px-3 py-1 bg-cream rounded-full text-xs font-medium text-ink-muted">+more</span>
            </div>
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="group reveal stagger-2">
          <div class="bg-paper-warm rounded-2xl p-8 border border-paper-dark h-full hover:border-copper/30 transition-colors">
            <div class="flex items-center gap-2 mb-6">
              <span class="text-label text-copper">02</span>
              <div class="waveform-line flex-1"></div>
            </div>
            <h3 class="heading-editorial text-2xl mb-3">RAG-based Q&A</h3>
            <p class="text-ink-muted leading-relaxed mb-6">
              Ask questions about your audio. Semantic search finds relevant chunks. The LLM generates answers grounded in actual transcript content.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-cream rounded-full text-xs font-medium text-ink-muted">Semantic search</span>
              <span class="px-3 py-1 bg-cream rounded-full text-xs font-medium text-ink-muted">Grounded</span>
            </div>
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="group reveal stagger-3">
          <div class="bg-ink rounded-2xl p-8 text-cream h-full border border-ink-muted hover:border-copper/50 transition-colors">
            <div class="flex items-center gap-2 mb-6">
              <span class="text-label text-copper-light">03</span>
              <div class="waveform-line flex-1" style="background: repeating-linear-gradient(90deg, var(--color-copper-light) 0px, var(--color-copper-light) 8px, transparent 8px, transparent 12px);"></div>
            </div>
            <h3 class="heading-editorial text-2xl mb-3">AI Agent</h3>
            <p class="text-paper-dark leading-relaxed mb-6">
              Goes beyond answers. Analyzes your question, the response and transcript evidence to recommend articles, videos, podcasts and reference materials.
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-ink-light rounded-full text-xs font-medium text-paper-dark">YouTube</span>
              <span class="px-3 py-1 bg-ink-light rounded-full text-xs font-medium text-paper-dark">Wikipedia</span>
              <span class="px-3 py-1 bg-ink-light rounded-full text-xs font-medium text-paper-dark">Articles</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  
  <!-- CTA -->
  <section class="py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <div class="max-w-2xl mx-auto">
        <h2 class="heading-display text-4xl lg:text-6xl mb-6 reveal">
          Ready to unlock<br />your audio?
        </h2>
      </div>
    </div>
  </section>
</Layout>
